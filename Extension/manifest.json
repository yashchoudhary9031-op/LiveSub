{
  "manifest_version": 3,
  "name": "LiveSub - Real-Time YouTube Subtitles",
  "version": "1.0.0",
  "description": "Real-time AI subtitles and translation for YouTube videos.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LiveSub Controls"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
